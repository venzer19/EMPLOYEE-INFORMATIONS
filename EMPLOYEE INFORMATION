).grid(row=0, column=1, padx=5)

tk.Button(
    button_frame, text="Delete", width=10,
    command=delete_employee
).grid(row=0, column=2, padx=5)

tk.Button(
    button_frame, text="Clear", width=10,
    command=clear_fields
).grid(row=0, column=3, padx=5)

tk.Button(
    button_frame, text="Exit", width=10,
    command=exit_program
).grid(row=0, column=4, padx=5)

tree = ttk.Treeview(
    root,
    columns=("ID", "Name", "Age", "Position"),
    show="headings"
)

tree.heading("ID", text="ID")
tree.heading("Name", text="Employee Name")
tree.heading("Age", text="Age")
tree.heading("Position", text="Position")

tree.column("ID", width=50)
tree.column("Name", width=220)
tree.column("Age", width=80)
tree.column("Position", width=220)

tree.pack(pady=10, fill="x", padx=10)

tree.bind("<<TreeviewSelect>>", select_employee)

display_employees()

root.mainloop()
